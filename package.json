    "@types/node": "^22.8.5",
    "dotenv": "^17.3.1",
    "forge-std": "foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.1.10",
    "typescript": "~5.8.0",
    "viem": "^2.43.0"
