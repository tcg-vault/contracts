    "verify:bsctest:buyrouter": "hardhat run scripts/verifyBsctestBuyRouterDeployed.ts --network bsctest",
    "fork:full": "hardhat run scripts/testFullFlowOnBSCFork.ts --network hardhat",
    "fork:dex": "hardhat run scripts/testOnBSCFork.ts --network hardhat",
    "update:subgraph:abis": "node scripts/update-subgraph-abis.mjs"
