  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "compile": "hardhat build",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "test": "hardhat test",
    "coverage": "node scripts/run-coverage.mjs",
    "coverage:production": "node scripts/run-coverage.mjs",
    "deploy:local": "hardhat run scripts/deployTCGVault.ts --network localhost",
