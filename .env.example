#
# Copy to ".env" and fill values.
#
# Networks:
#   - bsctest (chainId 97): yarn deploy:bsctest → scripts/deployBscTestnet.ts
#   - bsc     (chainId 56): yarn preflight:bsc / yarn deploy:bsc → scripts/deployBscMainnet.ts
#                           See contracts/docs/MAINNET_DEPLOYMENT.md
#
# -----------------------------------------------------------------------------
# WALLET REVIEW SHEET (French label → English → variable)
# Mainnet figé: docs/ADRESSES_DEPLOIEMENT_MAINNET.md (Livre Blanc Annexe 2)
# -----------------------------------------------------------------------------
# | FR (revue)                    | EN (same meaning)              | Variable              |
# |-------------------------------|--------------------------------|------------------------|
# | Vault / Coffre communautaire  | Community protocol vault       | VAULT_ADDRESS          |
# | Structure & Marketing         | Marketing & structure (fees)   | MARKETING_ADDRESS      |
# | Liquidité                     | Liquidity                      | LIQUIDITY_RECIPIENT    |
# | Burn / dead                   | (no wallet — see note below)   | —                      |
# | Récompenses communautaires    | Community rewards              | COMMUNITY_ADDRESS      |
# | Équipe Fondatrice (4%)        | Founding team vesting          | TEAM_RECIPIENT         |
# | Ops 5%+11% (→ Struct.&Mktg)   | Ops allocation                 | OPS_RECIPIENT          |
# -----------------------------------------------------------------------------
# Burn: TCGV burns reduce total supply in-contract; no recipient address in .env.
#      See contracts/docs/WALLET_ADDRESSES.md
# Founder paid mint: 100% USDC → CASP_USDC_ADDRESS (not split to vault/liquidity/ops on-chain).
# Réserve de Structuration (Annexe 3 / 70k) is NOT TEAM_RECIPIENT — off-contract wallet.
# -----------------------------------------------------------------------------

# Hardhat bsctest RPC endpoint
BSCTEST_RPC_URL="https://YOUR_BSCTEST_RPC_URL"

# Hardhat BSC mainnet RPC endpoint (also used for yarn fork:dex / fork:full)
BSC_RPC_URL="https://YOUR_BSC_RPC_URL"

# Tenderly Virtual TestNet (BSC fork) — rehearsal only. Live deploy: yarn deploy:bsc.
# VNets often use a custom chain id (this repo default: 99956).
TENDERLY_RPC_URL="https://virtual.binance.eu.rpc.tenderly.co/YOUR_VNET"
TENDERLY_CHAIN_ID="99956"

# Deployer private key used by Hardhat (do not commit real keys)
TCG_KEY="0xYOUR_PRIVATE_KEY"

# BscScan API key (required for verification)
BSC_SCAN_API_KEY="YOUR_BSCSCAN_API_KEY"

# --- Row 1: Community protocol vault (fee recipient) / FR: Vault communautaire ---
VAULT_ADDRESS="0xYOUR_VAULT_ADDRESS"

# --- Row 2: Marketing & structure / FR: Marketing & Structure ---
MARKETING_ADDRESS="0xYOUR_MARKETING_ADDRESS"

# --- Row 5: Community rewards / FR: Récompenses communautaires ---
COMMUNITY_ADDRESS="0xYOUR_COMMUNITY_ADDRESS"

# MiCA / CASP sinks (both required for full-stack deploy scripts):
# - CASP_USDC_ADDRESS → TCGVaultFounderNFT.mint() receives 100% of paid USDC
# - TREASURY_ADDRESS  → TCGVaultInitialLaunch.buy() USDC sink (often same address)
TREASURY_ADDRESS="0xYOUR_TREASURY_ADDRESS"
CASP_USDC_ADDRESS="0xYOUR_CASP_USDC_ADDRESS"

# --- Row 3: Liquidity / FR: Liquidité ---
# Post-presale TCGV liquidity allocation (setAllocationRecipients).
LIQUIDITY_RECIPIENT="0xYOUR_LIQUIDITY_RECIPIENT"

# --- Équipe Fondatrice (4% cliff 12 + vest 24) / FR: Équipe Fondatrice ---
# NOT Réserve de Structuration (Annexe 3) — that wallet is off-contract.
TEAM_RECIPIENT="0xYOUR_TEAM_RECIPIENT"

# Ops: 5% immediate + 11% vesting 36mo. Mainnet = Structure & Marketing safe.
OPS_RECIPIENT="0xYOUR_OPS_RECIPIENT"

# --- Stablecoin ---
# BSC mainnet (yarn deploy:bsc): REQUIRED. MockUSDC is refused.
# Common Binance-Peg USDC: 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d — confirm decimals() on-chain.
# BSC testnet (yarn deploy:bsctest): optional; if empty, script deploys MockUSDC (6 decimals, open mint).
USDC_ADDRESS=""

# Optional: set to 1 to skip TCGR + TCGRToTCGVConverter deployment
SKIP_TCGR="0"

# Optional: skip subgraph ABI sync after deploy
# SKIP_SUBGRAPH_SYNC="1"

# Optional: skip BscScan verification batch (mainnet script)
# SKIP_VERIFY="1"

# Optional: when deploying MockUSDC on testnet only — set to 0 to skip minting 1M to deployer
MOCK_USDC_MINT_DEPLOYER="1"

# Optional: wait time before verification batch
VERIFY_WAIT_SECONDS="30"

# Optional: min stake in TCGV as a decimal string (parseEther; default 5000)
# BASIC_NFT_MIN_STAKE="5000"

# Optional: legacy partial script only (deployTCGVault / deploy:bsc:legacy-partial)
# PANCAKE_ROUTER="0x10ED43C718714eb63d5aA57B78B54704E256024E"
# STABLECOIN_ADDRESS=""
